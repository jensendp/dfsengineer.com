---
interface Props {
  title: string;
  description: string;
  pubDate: Date;
  tags: string[];
  author: string;
  heroImage?: string;
}
const { title, description, pubDate, tags, author, heroImage } = Astro.props;
---
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title} — DFS Engineer Playbook</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={Astro.url.href} />
  </head>
  <body>
    <header><a href="/">DFS Engineer Playbook</a></header>
    <main>
      <article>
        {heroImage && <img src={heroImage} alt="" />}
        <h1>{title}</h1>
        <p class="meta">
          By {author} · {pubDate.toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' })}
          {tags.length > 0 && <> · {tags.join(', ')}</>}
        </p>
        <slot />
      </article>
    </main>
    <footer><a href="https://www.skool.com/brew-loyalty-6636">Join the DFS Engineer Playbook community</a></footer>
  </body>
</html>
