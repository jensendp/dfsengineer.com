---
import '../styles/global.css';

interface Props {
  title: string;
  description: string;
  pubDate: Date;
  tags: string[];
  author: string;
  heroImage?: string;
}
const { title, description, pubDate, tags, author } = Astro.props;
---
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title} — DFS Engineer</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={Astro.url.href} />
  </head>
  <body class="paper">
    <header class="site-header">
      <div class="wrap">
        <a class="wordmark" href="/" style="color: var(--color-ink);">DFS<span>·</span>Engineer</a>
      </div>
    </header>
    <main>
      <article>
        {/* heroImage intentionally not rendered — stock photos from the n8n
            pipeline don't fit the schematic-on-black design system. Revisit
            once there's a real asset pipeline (generated schematic/data-viz
            art). Field stays in the schema/props for when that lands. */}
        <h1>{title}</h1>
        <p class="meta">
          {author} · {pubDate.toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' })}
          {tags.length > 0 && <> · {tags.join(', ')}</>}
        </p>
        <slot />
      </article>
    </main>
    <footer class="site-footer">
      <div class="wrap">
        <a href="https://www.skool.com/brew-loyalty-6636">Join the DFS Engineer Playbook community →</a>
      </div>
    </footer>
  </body>
</html>
