---
import '../styles/global.css';
import { getCollection } from 'astro:content';

interface Props {
  title: string;
  description: string;
  pubDate: Date;
  tags: string[];
  author: string;
  pillar?: string;
  contentType?: string;
  slug: string;
  faqs?: { question: string; answer: string }[];
}
const { title, description, pubDate, tags, author, pillar, slug, faqs = [] } = Astro.props;

// "More in this series" — queried from real published content, not
// generated/patched text. See DESIGN.md and n8n-pipeline-review.md for why.
const seriesPosts = pillar
  ? (
      await getCollection(
        'blog',
        (entry) => !entry.data.draft && entry.data.pillar === pillar && entry.slug !== slug
      )
    ).sort((a, b) => a.data.pubDate.valueOf() - b.data.pubDate.valueOf())
  : [];

const canonicalURL = Astro.url.href;

const articleSchema = {
  '@context': 'https://schema.org',
  '@type': 'Article',
  headline: title,
  description,
  datePublished: pubDate.toISOString(),
  author: { '@type': 'Organization', name: author },
  publisher: { '@type': 'Organization', name: 'DFS Engineer Playbook' },
  mainEntityOfPage: { '@type': 'WebPage', '@id': canonicalURL },
};

const faqSchema = faqs.length > 0
  ? {
      '@context': 'https://schema.org',
      '@type': 'FAQPage',
      mainEntity: faqs.map((f) => ({
        '@type': 'Question',
        name: f.question,
        acceptedAnswer: { '@type': 'Answer', text: f.answer },
      })),
    }
  : null;
---
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Inter+Tight:wght@500;600;700;800&family=Inter:wght@400;500&family=JetBrains+Mono:wght@400;500;600&display=swap" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalURL} />

    <meta property="og:type" content="article" />
    <meta property="og:site_name" content="DFS Engineer" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalURL} />
    <meta name="twitter:card" content="summary" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />

    <script type="application/ld+json" set:html={JSON.stringify(articleSchema)} is:inline />
    {faqSchema && <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} is:inline />}
  </head>
  <body>
    <header class="site-header">
      <div class="wrap">
        <a class="wordmark" href="/">DFS<span>·</span>Engineer</a>
        <nav class="site-nav">
          <a href="/blog/">Blog</a>
          <a class="btn btn-secondary" href="https://www.skool.com/brew-loyalty-6636">Join the community →</a>
        </nav>
      </div>
    </header>

    <section class="hero-post">
      <div class="wrap">
        {pillar && <p class="eyebrow">§ {pillar}</p>}
        <h1>{title}</h1>
        <p class="meta">
          {author} · {pubDate.toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' })}
          {tags.length > 0 && <> · {tags.join(', ')}</>}
        </p>
      </div>
    </section>

    <main class="paper">
      <article>
        <slot />
      </article>
    </main>

    {seriesPosts.length > 0 && (
      <section class="section series-section">
        <div class="wrap">
          <p class="section-label">More in this series</p>
          <ul class="post-grid">
            {seriesPosts.map((post) => (
              <li>
                <a class="post-card" href={`/blog/${post.slug}/`}>
                  <h3>{post.data.title}</h3>
                  <p>{post.data.description}</p>
                </a>
              </li>
            ))}
          </ul>
        </div>
      </section>
    )}

    <footer class="site-footer">
      <div class="wrap">
        <a href="https://www.skool.com/brew-loyalty-6636">Join the DFS Engineer Playbook community →</a>
      </div>
    </footer>
  </body>
</html>
