---
import '../styles/global.css';
import { getCollection } from 'astro:content';
import Analytics from '../components/Analytics.astro';

interface Props {
  title: string;
  description: string;
  pubDate: Date;
  dateModified?: Date;
  tags: string[];
  author: string;
  pillar?: string;
  contentType?: string;
  hub?: string;
  season?: number;
  week?: number;
  slug: string;
  faqs?: { question: string; answer: string }[];
}
const {
  title, description, pubDate, dateModified, tags, author, pillar, hub, slug, faqs = [],
} = Astro.props;
const effectiveDateModified = dateModified ?? pubDate;

// "More in this series" — queried from real published content, not
// generated/patched text. See DESIGN.md and n8n-pipeline-review.md for why.
// Excludes this hub's own weekly posts when `hub` is set — those already
// render in the "This season's weeks" section below, and showing the
// same post in both sections on the hub anchor page is just noise.
const seriesPosts = pillar
  ? (
      await getCollection(
        'blog',
        (entry) =>
          (!entry.data.draft || import.meta.env.DEV) &&
          entry.data.pillar === pillar &&
          entry.slug !== slug &&
          !(hub && entry.data.hub === hub)
      )
    ).sort((a, b) => a.data.pubDate.valueOf() - b.data.pubDate.valueOf())
  : [];

// "This season's weeks" — renders on the hub anchor page (nfl-dfs-value-plays.md
// / nfl-dfs-matchup-analysis.md, which set `hub` but no `season`/`week`)
// AND on each individual weekly post (cross-links sibling weeks). Matched
// on `hub` alone, not `season` too — the anchor page is evergreen and
// doesn't belong to one season, so requiring season here would silently
// break the widget on the page it matters most on. Separate from
// seriesPosts above: that one clusters by broader pillar topic, this one
// is specifically this hub's weekly children, newest season/week first.
const hubWeekPosts = hub
  ? (
      await getCollection(
        'blog',
        (entry) => (!entry.data.draft || import.meta.env.DEV) && entry.data.hub === hub && entry.slug !== slug
      )
    ).sort((a, b) => (b.data.season ?? 0) - (a.data.season ?? 0) || (b.data.week ?? 0) - (a.data.week ?? 0))
  : [];

const canonicalURL = Astro.url.href;

const articleSchema = {
  '@context': 'https://schema.org',
  '@type': 'Article',
  headline: title,
  description,
  datePublished: pubDate.toISOString(),
  dateModified: effectiveDateModified.toISOString(),
  author: { '@type': 'Organization', name: author },
  publisher: { '@type': 'Organization', name: 'DFS Engineer Playbook' },
  mainEntityOfPage: { '@type': 'WebPage', '@id': canonicalURL },
};

const faqSchema = faqs.length > 0
  ? {
      '@context': 'https://schema.org',
      '@type': 'FAQPage',
      mainEntity: faqs.map((f) => ({
        '@type': 'Question',
        name: f.question,
        acceptedAnswer: { '@type': 'Answer', text: f.answer },
      })),
    }
  : null;

// Matches the visible breadcrumb trail below — structured data should
// describe what's actually on the page, not an invented hierarchy.
const breadcrumbSchema = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Home', item: 'https://www.dfsengineer.com/' },
    { '@type': 'ListItem', position: 2, name: 'Blog', item: 'https://www.dfsengineer.com/blog/' },
    { '@type': 'ListItem', position: 3, name: title, item: canonicalURL },
  ],
};
---
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Inter+Tight:wght@500;600;700;800&family=Inter:wght@400;500&family=JetBrains+Mono:wght@400;500;600&display=swap" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalURL} />

    <meta property="og:type" content="article" />
    <meta property="og:site_name" content="DFS Engineer" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalURL} />
    <meta name="twitter:card" content="summary" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />

    <script type="application/ld+json" set:html={JSON.stringify(articleSchema)} is:inline />
    {faqSchema && <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} is:inline />}
    <script type="application/ld+json" set:html={JSON.stringify(breadcrumbSchema)} is:inline />
    <Analytics />
  </head>
  <body>
    <header class="site-header">
      <div class="wrap">
        <a class="wordmark" href="/">DFS<span>·</span>Engineer</a>
        <nav class="site-nav">
          <a href="/blog/">Blog</a>
          <a href="/about/">About</a>
          <a class="btn btn-secondary" href="https://www.skool.com/brew-loyalty-6636">Join the community →</a>
        </nav>
      </div>
    </header>

    <section class="hero-post">
      <div class="wrap">
        <nav class="breadcrumbs" aria-label="Breadcrumb">
          <a href="/">Home</a><span>/</span><a href="/blog/">Blog</a><span>/</span><span aria-current="page">{title}</span>
        </nav>
        {pillar && <p class="eyebrow">§ {pillar}</p>}
        <h1>{title}</h1>
        <p class="meta">
          {author} · {pubDate.toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' })}
          {tags.length > 0 && <> · {tags.join(', ')}</>}
        </p>
      </div>
    </section>

    <main class="paper">
      <article>
        <slot />
      </article>
    </main>

    {hubWeekPosts.length > 0 && (
      <section class="section series-section">
        <div class="wrap">
          <p class="section-label">This season's weeks</p>
          <ul class="post-grid">
            {hubWeekPosts.map((post) => (
              <li>
                <a class="post-card" href={`/blog/${post.slug}/`}>
                  <h3>{post.data.title}</h3>
                  <p>{post.data.description}</p>
                </a>
              </li>
            ))}
          </ul>
        </div>
      </section>
    )}

    {seriesPosts.length > 0 && (
      <section class="section series-section">
        <div class="wrap">
          <p class="section-label">More in this series</p>
          <ul class="post-grid">
            {seriesPosts.map((post) => (
              <li>
                <a class="post-card" href={`/blog/${post.slug}/`}>
                  <h3>{post.data.title}</h3>
                  <p>{post.data.description}</p>
                </a>
              </li>
            ))}
          </ul>
        </div>
      </section>
    )}

    <footer class="site-footer">
      <div class="wrap">
        <a href="https://www.skool.com/brew-loyalty-6636">Join the DFS Engineer Playbook community →</a>
      </div>
    </footer>
  </body>
</html>
