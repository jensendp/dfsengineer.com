---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';

const posts = (await getCollection('blog', ({ data }) => !data.draft || import.meta.env.DEV)).sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()
);

// Pillar cards — one per published topic cluster, linking to that
// pillar's own post (which already lists its spokes via the "More in
// this series" widget in BlogPost.astro). No separate pillar-page type
// needed; a pillar IS a post, just one that aggregates its own cluster.
const pillars = posts.filter((post) => post.data.contentType === 'Pillar');

const breadcrumbSchema = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Home', item: 'https://www.dfsengineer.com/' },
    { '@type': 'ListItem', position: 2, name: 'Blog', item: 'https://www.dfsengineer.com/blog/' },
  ],
};
---
<BaseLayout
  title="Blog — DFS Engineer"
  description="Every post from DFS Engineer Playbook — fundamentals, scoring, strategy, and process, newest first."
  canonicalURL="https://www.dfsengineer.com/blog/"
>
  <Fragment slot="head">
    <script type="application/ld+json" set:html={JSON.stringify(breadcrumbSchema)} is:inline />
  </Fragment>

  <section class="hero">
    <div class="wrap">
      <nav class="breadcrumbs" aria-label="Breadcrumb">
        <a href="/">Home</a><span>/</span><span aria-current="page">Blog</span>
      </nav>
      <p class="eyebrow">§ Blog</p>
      <h1>The full playbook.</h1>
      <p class="lede">
        Browse by topic, or scan every post published so far, newest
        first — fundamentals, scoring mechanics, and process, all with
        the math shown.
      </p>
    </div>
  </section>

  {pillars.length > 0 && (
    <section class="section">
      <div class="wrap">
        <h2 class="section-label">Explore by topic</h2>
        <ul class="post-grid">
          {pillars.map((post) => (
            <li>
              <a class="post-card" href={`/blog/${post.slug}/`}>
                <h3>{post.data.pillar}</h3>
                <p>{post.data.description}</p>
              </a>
            </li>
          ))}
        </ul>
      </div>
    </section>
  )}

  <section class="section">
    <div class="wrap">
      <h2 class="section-label">All posts</h2>
      {posts.length === 0 && <p>First posts coming soon.</p>}
      <ul class="post-grid">
        {posts.map((post) => (
          <li>
            <a class="post-card" href={`/blog/${post.slug}/`}>
              <h3>{post.data.title}</h3>
              <p>{post.data.description}</p>
            </a>
          </li>
        ))}
      </ul>
    </div>
  </section>
</BaseLayout>
