---
import '../../styles/global.css';
import { getCollection } from 'astro:content';

const posts = (await getCollection('blog', ({ data }) => !data.draft)).sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()
);
---
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Blog — DFS Engineer</title>
    <meta name="description" content="Every post from DFS Engineer Playbook — fundamentals, scoring, strategy, and process, newest first." />
  </head>
  <body>
    <header class="site-header">
      <div class="wrap">
        <a class="wordmark" href="/">DFS<span>·</span>Engineer</a>
        <nav class="site-nav">
          <a href="/blog/">Blog</a>
          <a class="btn btn-secondary" href="https://www.skool.com/brew-loyalty-6636">Join the community →</a>
        </nav>
      </div>
    </header>

    <section class="hero">
      <div class="wrap">
        <p class="eyebrow">§ Blog</p>
        <h1>The full playbook.</h1>
        <p class="lede">
          Every post published so far, newest first — fundamentals, scoring
          mechanics, and process, all with the math shown.
        </p>
      </div>
    </section>

    <section class="section">
      <div class="wrap">
        {posts.length === 0 && <p>First posts coming soon.</p>}
        <ul class="post-grid">
          {posts.map((post) => (
            <li>
              <a class="post-card" href={`/blog/${post.slug}/`}>
                <h3>{post.data.title}</h3>
                <p>{post.data.description}</p>
              </a>
            </li>
          ))}
        </ul>
      </div>
    </section>

    <footer class="site-footer">
      <div class="wrap">
        <a href="https://www.skool.com/brew-loyalty-6636">Join the DFS Engineer Playbook community →</a>
      </div>
    </footer>
  </body>
</html>
