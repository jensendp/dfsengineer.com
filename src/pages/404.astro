---
import '../styles/global.css';
---
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Inter+Tight:wght@500;600;700;800&family=Inter:wght@400;500&family=JetBrains+Mono:wght@400;500;600&display=swap" />
    <title>Page not found — DFS Engineer</title>
    <meta name="robots" content="noindex" />
  </head>
  <body>
    <header class="site-header">
      <div class="wrap">
        <a class="wordmark" href="/">DFS<span>·</span>Engineer</a>
        <nav class="site-nav">
          <a href="/blog/">Blog</a>
          <a class="btn btn-secondary" href="https://www.skool.com/brew-loyalty-6636">Join the community →</a>
        </nav>
      </div>
    </header>

    <section class="hero">
      <div class="wrap">
        <p class="eyebrow">§ 404</p>
        <h1>That page busted.</h1>
        <p class="lede">
          Nothing here — the page you're looking for doesn't exist or moved.
        </p>
        <a class="btn btn-primary" href="/">Back to the playbook →</a>
      </div>
    </section>

    <footer class="site-footer">
      <div class="wrap">
        <a href="https://www.skool.com/brew-loyalty-6636">Join the DFS Engineer Playbook community →</a>
      </div>
    </footer>
