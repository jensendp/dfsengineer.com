---
import '../styles/global.css';
import { getCollection } from 'astro:content';

const posts = (await getCollection('blog', ({ data }) => !data.draft)).sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()
);
---
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>DFS Engineer — NFL DFS, run like a lab notebook</title>
    <meta name="description" content="An engineer's real NFL DFS process — projections, lineup building, and results, built in the open. Not a picks-selling service." />
  </head>
  <body>
    <header class="site-header">
      <div class="wrap">
        <a class="wordmark" href="/">DFS<span>·</span>Engineer</a>
        <a class="btn btn-secondary" href="https://www.skool.com/brew-loyalty-6636">Join the community →</a>
      </div>
    </header>

    <section class="hero">
      <div class="wrap">
        <p class="eyebrow">§ 01 — Process, not picks</p>
        <h1>NFL DFS, run<br />like a lab notebook.</h1>
        <p class="lede">
          Projections, lineup construction, and results — built in the open,
          with the math shown. If the model likes a play, you'll see why.
        </p>
        <a class="btn btn-primary" href="#latest">Read the playbook ↓</a>
      </div>
    </section>

    <section class="section">
      <div class="wrap">
        <p class="section-label">§ 02 — This week's signal</p>
        <div style="display:grid; grid-template-columns:repeat(auto-fit,minmax(140px,1fr)); gap:16px;">
          <div class="stat-card">
            <span class="stat-label">Slate</span>
            <span class="stat-value">Sun Main</span>
          </div>
          <div class="stat-card">
            <span class="stat-label">Top Ceiling</span>
            <span class="stat-value up">32.4</span>
          </div>
          <div class="stat-card">
            <span class="stat-label">Fade Risk</span>
            <span class="stat-value down">−18%</span>
          </div>
          <div class="stat-card">
            <span class="stat-label">Models Run</span>
            <span class="stat-value">10,000</span>
          </div>
        </div>
      </div>
    </section>

    <section class="section" id="latest">
      <div class="wrap">
        <p class="section-label">§ 03 — Latest from the playbook</p>
        {posts.length === 0 && <p>First posts coming soon.</p>}
        <ul class="post-grid">
          {posts.map((post) => (
            <li>
              <a class="post-card" href={`/blog/${post.slug}/`}>
                <h3>{post.data.title}</h3>
                <p>{post.data.description}</p>
              </a>
            </li>
          ))}
        </ul>
      </div>
    </section>

    <footer class="site-footer">
      <div class="wrap">
        <a href="https://www.skool.com/brew-loyalty-6636">Join the DFS Engineer Playbook community →</a>
      </div>
    </footer>
  </body>
</html>
