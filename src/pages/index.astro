---
import BaseLayout from '../layouts/BaseLayout.astro';
import {
  getPosts, sportOf, newestFirst, isHubEdition, editionLabel, loadSlate, nbaSeasonStarted,
  type Post, type Sport,
} from '../lib/site-data';

const allPosts = await getPosts();
const slate = loadSlate();
const slateWeek = slate?.name?.match(/\d+/)?.[0];

// Each sport panel: the newest weekly/nightly edition of each hub first (so
// the NFL weekly posts aren't pushed out by newer evergreen guides), then
// the newest guides to fill three rows.
function panelPosts(sport: Sport): Post[] {
  const mine = allPosts.filter((p) => sportOf(p) === sport);
  const latestPerHub = new Map<string, Post>();
  for (const p of mine.filter(isHubEdition).sort(newestFirst)) {
    if (!latestPerHub.has(p.data.hub!)) latestPerHub.set(p.data.hub!, p);
  }
  // The two weekly staples lead; newer series (signals, review) only fill in
  // if there's room, so they don't push value plays / matchups off the panel.
  const PRIORITY = ['value-plays', 'matchup-analysis'];
  const rank = (hub: string) => (PRIORITY.includes(hub) ? PRIORITY.indexOf(hub) : PRIORITY.length);
  const editions = [...latestPerHub.values()]
    .sort((a, b) => rank(a.data.hub!) - rank(b.data.hub!))
    .slice(0, 2);
  const guides = mine.filter((p) => !isHubEdition(p) && p.data.contentType === 'Pillar');
  return [...editions, ...guides].slice(0, 3);
}
const nfl = panelPosts('nfl');
const nba = panelPosts('nba');

// "Start here" cards — slugs checked against real content, missing ones skipped.
const startCards = [
  { slug: 'what-is-nfl-dfs-a-complete-beginners-breakdown-2026', kicker: 'Basics' },
  { slug: 'nba-dfs-vs-nfl-dfs-what-changes', kicker: 'Basics' },
  { slug: 'nfl-dfs-strategy-guide-a-complete-process-for-2026', kicker: 'Process' },
]
  .map((c) => ({ ...c, post: allPosts.find((p) => p.slug === c.slug) }))
  .filter((c) => c.post);

const nbaStarted = nbaSeasonStarted();

// Site-wide entity schema — set once here, not repeated per page. No
// `logo` field: there's no real logo image asset yet (the wordmark is
// text, not an image) — omitted rather than pointing at a placeholder
// that doesn't exist.
const organizationSchema = {
  '@context': 'https://schema.org',
  '@type': 'Organization',
  name: 'DFS Engineer Playbook',
  url: 'https://www.dfsengineer.com',
  sameAs: ['https://www.skool.com/brew-loyalty-6636'],
  founder: { '@type': 'Person', name: 'Derek Jensen', url: 'https://www.dfsengineer.com/about/' },
};
const websiteSchema = {
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  name: 'DFS Engineer',
  url: 'https://www.dfsengineer.com',
};
---
<BaseLayout
  title="DFS Engineer — NFL + NBA DFS, Run Like a Lab Notebook"
  description="An engineer's real DFS process — NFL and NBA projections, lineup building, and results, built in the open. Not a picks-selling service."
  canonicalURL="https://www.dfsengineer.com/"
>
  <Fragment slot="head">
    <script type="application/ld+json" is:inline set:html={JSON.stringify(organizationSchema)} />
    <script type="application/ld+json" is:inline set:html={JSON.stringify(websiteSchema)} />
  </Fragment>

  <section class="hero compact">
    <div class="wrap">
      <p class="eyebrow">Process, not picks</p>
      <h1>DFS, run like a lab notebook.</h1>
      <p class="lede">
        Projections, lineup construction, and results — NFL and NBA, built
        in the open, with the math shown. If the model likes a play,
        you'll see why.
      </p>
      <a class="btn btn-primary" href="/nfl/">NFL hub →</a>
      <a class="btn btn-secondary" href="/nba/">NBA hub →</a>
    </div>
  </section>

  <section class="section">
    <div class="wrap">
      <h2 class="section-label">Pick a sport</h2>
      <div class="sport-grid">
        <article class="sport-panel">
          <header>
            <h2>NFL</h2>
            <span class="badge live">In season{slateWeek ? ` · Week ${slateWeek}` : ''}</span>
          </header>
          {slate && (
            <div class="sport-status">
              <span>Slate <b>{slate.name}</b></span>
              <span>Games <b>{slate.numGames}</b></span>
              {slate.highestTotal && <span>Top total <b>{slate.highestTotal.over_under}</b></span>}
            </div>
          )}
          <ul class="mini-list">
            {nfl.map((p) => (
              <li><a href={`/blog/${p.slug}/`}><span>{p.data.title}</span><span class="tag">{editionLabel(p)}</span></a></li>
            ))}
          </ul>
          <div class="actions"><a class="btn btn-primary" href="/nfl/">Go to NFL hub →</a></div>
        </article>

        <article class="sport-panel">
          <header>
            <h2>NBA</h2>
            {nbaStarted ? <span class="badge live">In season</span> : <span class="badge soon">Season starts Oct 20</span>}
          </header>
          <div class="sport-status">
            <span>Season <b>2026-27</b></span>
            <span>Scorecard <b>{nbaStarted ? 'Live' : 'Opens with real games'}</b></span>
          </div>
          <ul class="mini-list">
            {nba.map((p) => (
              <li><a href={`/blog/${p.slug}/`}><span>{p.data.title}</span><span class="tag">{editionLabel(p)}</span></a></li>
            ))}
          </ul>
          <div class="actions">
            <a class="btn btn-primary" href="/nba/">Go to NBA hub →</a>
            <a class="btn btn-secondary" href="/nba/scorecard/">Scorecard</a>
          </div>
        </article>
      </div>
    </div>
  </section>

  <section class="section nopad-top">
    <div class="wrap">
      <h2 class="section-label">New to DFS? Start here</h2>
      <ul class="start-grid">
        {startCards.map((c) => (
          <li><a class="post-card" href={`/blog/${c.post!.slug}/`}><span class="kicker">{c.kicker}</span><h3>{c.post!.data.title}</h3></a></li>
        ))}
      </ul>
      <p style="margin-top:16px"><a class="btn btn-secondary" href="/start/">See the full starter path →</a></p>
    </div>
  </section>

  <section class="section nopad-top">
    <div class="wrap">
      <div class="trust-strip">
        <p>
          <strong style="color:var(--color-chalk)">Graded in public.</strong>
          Projections are scored against real results: the NFL model's backtested accuracy now, and the NBA scorecard once games are played.
        </p>
        <span>
          <a class="btn btn-secondary" href="/nfl/#accuracy">NFL accuracy</a>
          <a class="btn btn-secondary" href="/nba/scorecard/">NBA scorecard</a>
        </span>
      </div>
      <p style="margin-top:24px"><a href="/blog/" class="mono" style="font-size:13px">Browse all {allPosts.length} posts →</a></p>
    </div>
  </section>
</BaseLayout>
