---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';
import { readFileSync } from 'node:fs';

const allPosts = (await getCollection('blog', ({ data }) => !data.draft)).sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()
);
// Homepage shows only the most recent — the full, unbounded list lives at
// /blog/. Without this cap the homepage would grow a new card forever as
// content publishes, eventually becoming an unusable single-page wall.
const LATEST_COUNT = 6;
const posts = allPosts.slice(0, LATEST_COUNT);
const hasMore = allPosts.length > LATEST_COUNT;

// "Model accuracy" stat cards — real numbers from the dfs-local backtest
// export (see dfs-local/src/dfs_local/export/content_grounding.py), read
// at build time from the file the pipeline already commits to this repo.
// A snapshot, not a live trend — refreshed by manually re-running
// `dfs-local push-content-export`, so it's labeled with the date it was
// actually generated rather than implying it's continuously live.
// No fabricated placeholders: if the export is missing or empty, the
// section renders nothing rather than a fake number.
type AccuracyRow = { profile: string; position: string; n: number; mae: number; corr: number | null };
let accuracyCards: { label: string; value: string }[] = [];
let accuracyGeneratedAt: string | null = null;
try {
  const raw = readFileSync(new URL('../../data/dfs-local-export.json', import.meta.url), 'utf-8');
  const exportData = JSON.parse(raw);
  const rows: AccuracyRow[] = exportData?.model_accuracy?.by_profile_position ?? [];
  const defaultRows = rows.filter((r) => r.profile === 'default' && r.corr !== null);
  const order = ['QB', 'RB', 'WR', 'TE'];
  const byPosition = order
    .map((pos) => defaultRows.find((r) => r.position === pos))
    .filter((r): r is AccuracyRow => Boolean(r));
  if (byPosition.length > 0) {
    accuracyCards = byPosition.map((r) => ({
      label: `${r.position} Model Corr`,
      value: r.corr!.toFixed(3),
    }));
    accuracyGeneratedAt = exportData?.generated_at ?? null;
  }
} catch {
  accuracyCards = [];
}

// "This week's slate" — game-level market facts only (matchups, Vegas
// lines), never player-level data. See
// dfs-local/src/dfs_local/export/slate_snapshot.py for the scope rule.
// Highlight fields come back null until real odds data exists for the
// slate; the section renders only the fields that are actually present.
type SlateHighlight = { matchup: string; over_under?: number; spread?: number } | null;
let slateInfo: { name: string | null; numGames: number } | null = null;
let highestTotal: SlateHighlight = null;
let biggestSpread: SlateHighlight = null;
try {
  const raw = readFileSync(new URL('../../data/slate-snapshot.json', import.meta.url), 'utf-8');
  const snapshot = JSON.parse(raw);
  if (snapshot?.slate?.num_games > 0) {
    slateInfo = { name: snapshot.slate.slate_name, numGames: snapshot.slate.num_games };
    highestTotal = snapshot?.highlights?.highest_total ?? null;
    biggestSpread = snapshot?.highlights?.biggest_spread ?? null;
  }
} catch {
  slateInfo = null;
}

const dateFmt = (iso: string) =>
  new Date(iso).toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' });

// Site-wide entity schema — set once here, not repeated per page. No
// `logo` field: there's no real logo image asset yet (the wordmark is
// text, not an image) — omitted rather than pointing at a placeholder
// that doesn't exist.
const organizationSchema = {
  '@context': 'https://schema.org',
  '@type': 'Organization',
  name: 'DFS Engineer Playbook',
  url: 'https://www.dfsengineer.com',
  sameAs: ['https://www.skool.com/brew-loyalty-6636'],
  founder: { '@type': 'Person', name: 'Derek Jensen', url: 'https://www.dfsengineer.com/about/' },
};
const websiteSchema = {
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  name: 'DFS Engineer',
  url: 'https://www.dfsengineer.com',
};
---
<BaseLayout
  title="DFS Engineer — NFL DFS, run like a lab notebook"
  description="An engineer's real NFL DFS process — projections, lineup building, and results, built in the open. Not a picks-selling service."
  canonicalURL="https://www.dfsengineer.com/"
>
  <Fragment slot="head">
    <script type="application/ld+json" is:inline set:html={JSON.stringify(organizationSchema)} />
    <script type="application/ld+json" is:inline set:html={JSON.stringify(websiteSchema)} />
  </Fragment>

  <section class="hero">
    <div class="wrap">
      <p class="eyebrow">§ 01 — Process, not picks</p>
      <h1>NFL DFS, run<br />like a lab notebook.</h1>
      <p class="lede">
        Projections, lineup construction, and results — built in the open,
        with the math shown. If the model likes a play, you'll see why.
      </p>
      <a class="btn btn-primary" href="#latest">Read the playbook ↓</a>
    </div>
  </section>

  {slateInfo && (
    <section class="section">
      <div class="wrap">
        <h2 class="section-label">§ 02 — This week's slate</h2>
        <div style="display:grid; grid-template-columns:repeat(auto-fit,minmax(140px,1fr)); gap:16px;">
          <div class="stat-card">
            <span class="stat-label">Slate</span>
            <span class="stat-value">{slateInfo.name}</span>
          </div>
          <div class="stat-card">
            <span class="stat-label">Games</span>
            <span class="stat-value">{slateInfo.numGames}</span>
          </div>
          {highestTotal && (
            <div class="stat-card">
              <span class="stat-label">Highest Total</span>
              <span class="stat-value up">{highestTotal.over_under}</span>
              <span class="mono" style="display:block; margin-top:4px; font-size:12px; color:var(--color-fog);">{highestTotal.matchup}</span>
            </div>
          )}
          {biggestSpread && (
            <div class="stat-card">
              <span class="stat-label">Biggest Spread</span>
              <span class="stat-value">{biggestSpread.spread}</span>
              <span class="mono" style="display:block; margin-top:4px; font-size:12px; color:var(--color-fog);">{biggestSpread.matchup}</span>
            </div>
          )}
        </div>
        <p style="margin-top:16px; font-size:13px;">
          Game-level market facts only — matchups and Vegas lines, the same information any sportsbook already publishes. Never a pick, never player-level data.
          {!highestTotal && ' Odds data isn’t in yet for this slate — check back closer to kickoff.'}
        </p>
      </div>
    </section>
  )}

  {accuracyCards.length > 0 && (
    <section class="section">
      <div class="wrap">
        <h2 class="section-label">§ 03 — Model accuracy, backtested</h2>
        <div style="display:grid; grid-template-columns:repeat(auto-fit,minmax(140px,1fr)); gap:16px;">
          {accuracyCards.map((card) => (
            <div class="stat-card">
              <span class="stat-label">{card.label}</span>
              <span class="stat-value up">{card.value}</span>
            </div>
          ))}
        </div>
        <p style="margin-top:16px; font-size:13px;">
          Correlation between projected and actual DraftKings points, by position — from real backtested slates, not a live claim.
          {accuracyGeneratedAt && ` As of ${dateFmt(accuracyGeneratedAt)}.`}
          {' '}See the methodology behind these numbers in the playbook below.
        </p>
      </div>
    </section>
  )}

  <section class="section" id="latest">
    <div class="wrap">
      <h2 class="section-label">§ 04 — Latest from the playbook</h2>
      {posts.length === 0 && <p>First posts coming soon.</p>}
      <ul class="post-grid">
        {posts.map((post) => (
          <li>
            <a class="post-card" href={`/blog/${post.slug}/`}>
              <h3>{post.data.title}</h3>
              <p>{post.data.description}</p>
            </a>
          </li>
        ))}
      </ul>
      {hasMore && (
        <p style="margin-top:24px;">
          <a class="btn btn-secondary" href="/blog/">View all posts →</a>
        </p>
      )}
    </div>
  </section>
</BaseLayout>
