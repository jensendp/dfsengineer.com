---
import { getCollection } from 'astro:content';

const posts = (await getCollection('blog', ({ data }) => !data.draft)).sort(
  (a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()
);
---
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>DFS Engineer Playbook</title>
    <meta name="description" content="An engineer's real NFL DFS process — projections, lineup building, and results, built in the open. Not a picks-selling service." />
  </head>
  <body>
    <header>
      <h1>DFS Engineer Playbook</h1>
      <p>A real, data-driven NFL DFS process — not someone else's picks.</p>
      <p><a href="https://www.skool.com/brew-loyalty-6636">Join the community on Skool →</a></p>
    </header>
    <main>
      <h2>Latest</h2>
      {posts.length === 0 && <p>First posts coming soon.</p>}
      <ul>
        {posts.map((post) => (
          <li>
            <a href={`/blog/${post.slug}/`}>{post.data.title}</a>
            <p>{post.data.description}</p>
          </li>
        ))}
      </ul>
    </main>
  </body>
</html>
